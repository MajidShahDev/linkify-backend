# Application
PORT=8081
NODE_ENV=development
BASE_URL=https://localhost:8081

# Database
MONGO_URL=mongodb://localhost:27017/linkify-backend

# Application Secrets
JWT_SECRET=your-jwt-secret-at-least-32-characters
STATE_SECRET=your-state-secret-at-least-32-characters
OBFUSCATION_SECRET=your-obfuscation-secret-at-least-32-characters
SESSION_SECRET=your-session-secret-at-least-32-characters

# Email
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sentry
SENTRY_DSN=your-sentry-dsn

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_ID=your-stripe-price-id
STRIPE_SUCCESS_URL=https://localhost:8081/payment/success
STRIPE_CANCEL_URL=https://localhost:8081/payment/cancel

# Redis
REDIS_URL=redis://localhost:6379