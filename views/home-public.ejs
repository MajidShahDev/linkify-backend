<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Linkify</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="font-sans bg-gray-100 m-0 p-0">
    <div class="container max-w-4xl mx-auto bg-white p-6 rounded-lg shadow-lg my-10">
        <header class="flex justify-between items-center mb-6">

            <!-- Logo -->
            <a href="/" class="no-underline">
                <h1 class="text-gray-800 text-2xl m-0 font-medium">Linkify</h1>
            </a>

            <!-- Right Section -->
            <div class="flex items-center gap-4">

                <!-- User Info Card -->
                <div class="flex items-center gap-3">
                    <a href="/login"
                        class="px-4 py-2 text-gray-700 border border-gray-300 rounded-md hover:bg-gray-100 transition">
                        Login
                    </a>

                    <a href="/signup" class="px-4 py-2 text-white bg-blue-600 rounded-md hover:bg-blue-700 transition">
                        Sign Up
                    </a>
                </div>

            </div>

        </header>

        <div class="max-w-xl mx-auto mt-10 px-4">

            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-gray-800">
                    Shorten Your URL
                </h1>

                <p class="mt-2 text-gray-600">
                    Create a short link quickly and easily.
                </p>
            </div>


            <form method="post" action="/url">

                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

                <label class="block">
                    Paste Your Long URL Here

                    <input type="text" name="url" placeholder="https://example.com/long-url"
                        value="<%= oldInput ? oldInput.url : '' %>"
                        class="w-full mt-2 p-2 border border-gray-300 rounded outline-gray-400 hover:border-gray-400"
                        required>
                </label>
                <% if (errors && errors.length> 0) { %>
                    <ul class="text-red-600 mt-2">
                        <% errors.forEach(msg=> { %>
                            <li>
                                <%= msg %>
                            </li>
                            <% }) %>
                    </ul>
                    <% } %>


                        <div class="mt-4">

                            <label for="customAlias" class="block text-sm text-gray-700 mb-1">
                                Customize your short link
                                <span class="text-gray-500">(Optional)</span>
                            </label>

                            <input id="customAlias" name="customAlias" type="text" placeholder="e.g. my-portfolio"
                                value="<%= oldInput?.customAlias || '' %>" maxlength="30"
                                class="w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />

                            <p class="mt-1 text-xs text-gray-500">
                                Leave empty to generate a random short link.
                            </p>

                        </div>

                        <button type="submit"
                            class="w-full mt-5 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded cursor-pointer">
                            Generate Short Link
                        </button>

            </form>

            <div class="text-center mt-6 text-sm text-gray-600">
                Already have an account?
                <a href="/login" class="text-blue-600 hover:underline">
                    Sign in
                </a>
            </div>

        </div>
    </div>
</body>

</html>